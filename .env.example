DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5433/atlas

# JSON list of directories that /repositories/analyze may read.
# Required for that endpoint: if unset or empty, every analysis request returns 403.
# ALLOWED_REPOSITORY_ROOTS=["/absolute/path/to/your/repos"]

# Neo4j for the code knowledge graph (docker compose service "neo4j").
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=atlas_dev_password
NEO4J_DATABASE=neo4j

# Embeddings for code retrieval (POST /repositories/{id}/index and /search).
# "hashing" is local and deterministic: no network, no model download.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=atlas-hashing-v1
# Must equal the code_chunks.embedding column dimension (1024).
EMBEDDING_DIMENSIONS=1024
# For a real model, use any OpenAI-compatible /embeddings endpoint, e.g. Ollama:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_API_KEY=
# A non-localhost endpoint receives your source code. It is refused unless this is true.
# EMBEDDING_ALLOW_EXTERNAL=false
# EMBEDDING_SEND_DIMENSIONS=false
# EMBEDDING_BATCH_SIZE=64

# Debugging agent (POST /debug/investigate). Investigation endpoints return 503 until this works.
# The agent sends repository source code to the Anthropic API. It is refused unless this is true.
# LLM_ALLOW_EXTERNAL=false
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=high
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Re-run a request declined by a safety classifier on a recommended fallback model.
# LLM_SERVER_FALLBACKS=true
# Agent limits (starting values).
# AGENT_MAX_ITERATIONS=12
# AGENT_MAX_TOOL_CALLS=20
# AGENT_TOOL_TIMEOUT_SECONDS=15
# AGENT_MAX_TOOL_OUTPUT_BYTES=20000
# AGENT_MAX_DURATION_SECONDS=120
# JSON list of directories whose tests the agent may run. Empty: run_tests is refused.
# Running tests is code execution, not a sandbox. List trusted repositories only.
# AGENT_TRUSTED_TEST_ROOTS=["/absolute/path/to/trusted/repos"]
