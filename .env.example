DATABASE_URL=postgresql+psycopg://atlas:atlas_dev_password@localhost:5433/atlas

# JSON list of directories that /repositories/analyze may read.
# Required for that endpoint: if unset or empty, every analysis request returns 403.
# ALLOWED_REPOSITORY_ROOTS=["/absolute/path/to/your/repos"]

# Neo4j for the code knowledge graph (docker compose service "neo4j").
NEO4J_URI=bolt://localhost:7688
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=atlas_dev_password
NEO4J_DATABASE=neo4j

# Embeddings for code retrieval (POST /repositories/{id}/index and /search).
# "hashing" is local and deterministic: no network, no model download.
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=atlas-hashing-v1
# Must equal the code_chunks.embedding column dimension (1024).
EMBEDDING_DIMENSIONS=1024
# For a real model, use any OpenAI-compatible /embeddings endpoint, e.g. Ollama:
# EMBEDDING_PROVIDER=openai_compatible
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# EMBEDDING_MODEL=mxbai-embed-large
# EMBEDDING_API_KEY=
# A non-localhost endpoint receives your source code. It is refused unless this is true.
# EMBEDDING_ALLOW_EXTERNAL=false
# EMBEDDING_SEND_DIMENSIONS=false
# EMBEDDING_BATCH_SIZE=64

# Debugging agent (POST /debug/investigate). Investigation endpoints return 503 until this works.
# The agent sends repository source code to the Anthropic API. It is refused unless this is true.
# LLM_ALLOW_EXTERNAL=false
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=anthropic
# LLM_MODEL=claude-opus-5-5
# LLM_EFFORT=high
# LLM_TIMEOUT_SECONDS=60
# LLM_MAX_RETRIES=2
# Re-run a request declined by a safety classifier on a recommended fallback model.
# LLM_SERVER_FALLBACKS=true
# Agent limits (starting values).
# AGENT_MAX_ITERATIONS=12
# AGENT_MAX_TOOL_CALLS=20
# AGENT_TOOL_TIMEOUT_SECONDS=15
# AGENT_MAX_TOOL_OUTPUT_BYTES=20000
# AGENT_MAX_DURATION_SECONDS=120
# JSON list of directories whose tests the agent may run. Empty: run_tests is refused.
# Running tests is code execution, not a sandbox. List trusted repositories only.
# AGENT_TRUSTED_TEST_ROOTS=["/absolute/path/to/trusted/repos"]

# Patch generation and verification (POST /debug/investigations/{id}/patches).
# Patches are verified only for repositories under AGENT_TRUSTED_TEST_ROOTS: verification runs their tests.
# PATCH_MAX_ATTEMPTS=3
# Verification time (baseline and checks) per request. Each attempt's LLM call is bounded separately.
# PATCH_MAX_TOTAL_SECONDS=180
# PATCH_LLM_TIMEOUT_SECONDS=120
# Global LLM budget per request, across every attempt and repair call. Each call's worst-case
# cost is reserved first; a call that might not fit is not made.
# PATCH_MAX_LLM_REQUESTS=6
# PATCH_MAX_LLM_SECONDS=300
# PATCH_MAX_LLM_COST_USD=1.00
# Graph test discovery: suggests tests that call the patchable code (Neo4j if current, else in-memory).
# PATCH_GRAPH_TEST_DISCOVERY=true
# PATCH_GRAPH_MAX_DEPTH=3
# PATCH_MAX_GRAPH_TEST_FILES=10
# Where repository tests run: local (a child process, not a sandbox) or container (one locked-down
# Docker container per run; build docker/test-runner.Dockerfile first). No fallback if unavailable.
# PATCH_TEST_BACKEND=local
# PATCH_CONTAINER_IMAGE=atlas-ai-test-runner:py3.12.13-pytest9.2.0
# PATCH_CONTAINER_CPUS=1.0
# PATCH_CONTAINER_MEMORY_MB=1024
# PATCH_CONTAINER_PIDS_LIMIT=256
# Container backend only: also verify repositories outside AGENT_TRUSTED_TEST_ROOTS. Security-sensitive.
# PATCH_CONTAINER_ALLOW_UNTRUSTED=false
# PATCH_MAX_FILES=5
# PATCH_MAX_CHANGED_LINES=500
# PATCH_MAX_CHECK_OUTPUT_BYTES=100000
# PATCH_CHECK_TIMEOUT_SECONDS=60
# The targeted baseline runs this many times; outcomes that differ are flaky.
# PATCH_BASELINE_RUNS=2
# A patched run that times out where the baseline completed: reject (likely hang) or inconclusive.
# PATCH_TIMEOUT_POLICY=reject
# PATCH_REQUIRE_RUFF=true
# Isolated copies live here (default: <system temp>/atlas-ai/patch-workspaces).
# PATCH_WORKSPACE_DIR=
# delete | keep_failed | keep
# PATCH_WORKSPACE_RETENTION=delete
# PATCH_WORKSPACE_MAX_AGE_HOURS=24
