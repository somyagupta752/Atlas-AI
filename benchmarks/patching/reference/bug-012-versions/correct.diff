+def _version_key(version: str) -> tuple[int, ...]:
+    """'1.10.0' -> (1, 10, 0, 1, 0); '2.0.0-rc2' -> (2, 0, 0, 0, 2). A release sorts after its candidates."""
+    release, _, candidate = version.partition("-")
+    numbers = tuple(int(part) for part in release.split("."))
+    return (*numbers, 0, int(candidate.removeprefix("rc"))) if candidate else (*numbers, 1, 0)
+
+
 def is_newer(candidate: str, current: str) -> bool:
     """True when ``candidate`` is a later release than ``current``."""
-    return candidate > current
+    return _version_key(candidate) > _version_key(current)
