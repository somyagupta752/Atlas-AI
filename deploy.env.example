# Variables for docker-compose.prod.yml. Copy to deploy.env (ignored by Git and by Docker builds) and fill in.
# This file holds NO secrets: passwords and keys are files under SECRETS_DIR (see docs/deployment.md).

# --- required ---
REGISTRY=ghcr.io/your-organisation
ATLAS_VERSION=replace-with-an-image-tag
# Absolute path on the Docker host; created by you, owned by uid 10001, mode 700. Mounted at the same path in the api.
WORKSPACE_HOST_DIR=/var/lib/atlas/workspaces
# Absolute host directory holding the repositories Atlas may analyse (mounted read-only).
REPOSITORIES_DIR=/srv/repositories

# --- password-reset email (required unless AUTH_PASSWORD_RESET_ENABLED=false) ---
# Any SMTP server works, including the SMTP interface of a transactional provider. The password goes in secrets/smtp_password.
SMTP_HOST=smtp.example.com
# SMTP_PORT=587                         # 587 with starttls, 465 with ssl
# SMTP_SECURITY=starttls                # starttls | ssl  (certificates and host names are always verified)
# SMTP_USERNAME=
SMTP_FROM=atlas@example.com             # a sender or domain your provider has verified
PUBLIC_BASE_URL=https://atlas.example.com   # where users open the dashboard; must be https://, no path
# AUTH_PASSWORD_RESET_ENABLED=true      # false switches reset off (the endpoint still answers the same way)

# --- optional ---
# COMPOSE_PROJECT_NAME=atlas
# ATLAS_ENVIRONMENT=production          # or staging
# SECRETS_DIR=./secrets
# FRONTEND_BIND=127.0.0.1               # loopback: put a TLS proxy in front
# FRONTEND_PORT=8080
# WORKER_IMAGE=atlas-ai-test-runner:py3.12.13-pytest9.2.0   # must already exist on the Docker host
# INSTANCE_ID=atlas                     # distinct per deployment sharing one Docker host
# AUTH_REGISTRATION_OPEN=true           # set false once your users exist
# LLM_ALLOW_EXTERNAL=false              # true sends repository code to the model provider
# CORS_ALLOWED_ORIGINS=[]               # https:// origins only, only if another origin calls the API
# APP_SUBNET=172.29.20.0/24
# DOCKER_SOCKET=/var/run/docker.sock
